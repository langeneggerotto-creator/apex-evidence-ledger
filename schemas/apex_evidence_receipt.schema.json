{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/schemas/apex_evidence_receipt.schema.json",
  "title": "APEX Evidence Receipt Schema",
  "description": "Public-safe contract for recording an artifact claim, evidence, validation scope, limitations, promotion state and next gate.",
  "type": "object",
  "required": ["receipt_id", "version", "created_date", "module_id", "public_safe", "artifact", "claim", "truth_status", "evidence", "validation", "limitations", "promotion", "next_gate"],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "created_date": {"type": "string", "format": "date"},
    "module_id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
    "public_safe": {"const": true},
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "artifact_type", "repository", "path_or_reference"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_type": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "path_or_reference": {"type": "string", "minLength": 1},
        "commit_sha": {"type": ["string", "null"]},
        "content_hash": {"type": ["string", "null"]}
      }
    },
    "claim": {
      "type": "object",
      "required": ["statement", "claim_type"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "claim_type": {"enum": ["ARTIFACT_EXISTS", "DESIGN_DEFINED", "PROTOTYPE_WORKS", "TEST_PASSED", "PILOT_RESULT", "DEPLOYMENT_STATUS", "BENEFIT_OUTCOME", "LIMITATION"]}
      }
    },
    "truth_status": {"enum": ["VERIFIED", "INFERRED", "DESIGNED_NOT_PROVEN", "PROTOTYPE", "TESTED", "BLOCKED", "ASPIRATIONAL"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_type", "reference", "supports_claim"],
        "properties": {
          "evidence_type": {"type": "string"},
          "reference": {"type": "string", "minLength": 1},
          "supports_claim": {"type": "string", "minLength": 1},
          "verification_method": {"type": ["string", "null"]}
        }
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test_id", "result", "scope"],
        "properties": {
          "test_id": {"type": "string"},
          "result": {"enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED", "NOT_APPLICABLE"]},
          "scope": {"type": "string"},
          "evidence_reference": {"type": ["string", "null"]}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "promotion": {
      "type": "object",
      "required": ["current_state", "recommended_decision", "human_approval_required"],
      "properties": {
        "current_state": {"type": "string"},
        "recommended_decision": {"enum": ["PROMOTE", "HOLD", "REPAIR", "ROLLBACK", "RETEST", "NO_CHANGE"]},
        "human_approval_required": {"type": "boolean"},
        "approved_by": {"type": ["string", "null"]}
      }
    },
    "next_gate": {"type": "string", "minLength": 1},
    "final_direction_stack": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["rank", "direction", "control_gate"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1, "maximum": 4},
          "direction": {"type": "string"},
          "control_gate": {"type": "string"},
          "sandboxed_innovation": {"type": "boolean"}
        }
      }
    }
  }
}
